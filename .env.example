# ==============================================================================
# CPA (Centralized Pocket Account) — Environment Variable Configuration Guide
# ==============================================================================
# Environment variables must be configured ONCE in your deployment environment
# (e.g. Vercel Project Settings or Cloud Run environment).
# Normal CPA users are NEVER prompted to enter API keys or secrets.
# ==============================================================================

# 1. Gemini AI API Key (Injected automatically by AI Studio)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# 2. Host Application URL (Injected automatically by AI Studio / Cloud Run)
APP_URL="MY_APP_URL"

# ==============================================================================
# PRODUCTION ENVIRONMENT VARIABLES (CONFIGURE IN VERCEL / SERVER RUNTIME)
# The server automatically reads these from process.env.
# Do NOT uncomment with empty values in development to avoid repeated UI prompts.
# ==============================================================================
# PAYMENT_GATEWAY_MODE=test
# RAZORPAY_TEST_KEY_ID=rzp_test_...
# RAZORPAY_TEST_KEY_SECRET=your_razorpay_test_secret
# RAZORPAY_LIVE_KEY_ID=rzp_live_...
# RAZORPAY_LIVE_KEY_SECRET=your_razorpay_live_secret
# RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
# TWILIO_ACCOUNT_SID=your_twilio_sid
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_PHONE_NUMBER=+1234567890
# DATABASE_URL=your_postgresql_or_supabase_url
# DATABASE_FILE=./cpa_production.db
# ADMIN_SETUP_SECRET=your_admin_secret
